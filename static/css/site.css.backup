 .location{background:linear-gradient(180deg,#fff 0%,#fff 100%);color:var(--ink);padding-top:105px;padding-bottom:105px;display:grid;grid-template-columns:.82fr 1.18fr;gap:8vw;align-items:center;margin-top:100px}.location .section-kicker{color:var(--orange)}.location h2{font:clamp(58px,7vw,100px)/.88 'Barlow Condensed';text-transform:uppercase;margin:47px 0 28px}.location h2 em{color:var(--orange);font-style:normal}.location-copy>p{max-width:330px;color:var(--muted);line-height:1.7}.location-address{display:flex;gap:16px;align-items:flex-start;margin:40px 0 31px;padding:22px 0;border-top:1px solid rgba(0,76,138,.15);border-bottom:1px solid rgba(0,76,138,.15)}.location-pin{display:grid;place-items:center;width:40px;height:40px;border:1px solid var(--orange);color:var(--orange);font-size:26px;line-height:1;border-radius:12px;background:rgba(240,90,40,.06)}.location-address small{display:block;color:var(--orange);font-size:10px;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-bottom:7px}.location-address strong{font-size:13px;line-height:1.6}.button-light{background:var(--ink);color:#fff;padding:15px 22px;border-radius:999px;display:inline-flex;align-items:center;gap:8px;box-shadow:0 15px 30px rgba(0,76,138,.12)}.button-light:hover{background:var(--orange);box-shadow:0 18px 35px rgba(0,139,250,.2)}.location-map{height:490px;position:relative;background:#fff;overflow:hidden;border:12px solid var(--white);box-shadow:18px 18px 0 #008FFA;border-radius:28px}.location-map iframe{width:100%;height:100%;border:0;filter:grayscale(1) contrast(.96) brightness(.92)}.map-label{position:absolute;z-index:1;left:24px;top:24px;background:rgba(0,76,138,.92);backdrop-filter:blur(8px);color:#fff;padding:12px 16px;font-size:10px;letter-spacing:1.5px;font-weight:700;border-radius:999px}.map-label span{color:var(--yellow);margin-left:6px}@media(max-width:850px){.location{grid-template-columns:1fr;gap:55px;padding-top:75px;padding-bottom:85px}.location-map{height:390px;box-shadow:12px 12px 0 var(--yellow)}}@media(max-width:500px){.location-map{height:300px;border-width:8px;border-radius:18px}.map-label{left:14px;top:14px;font-size:9px;padding:10px 12px}.location-address{padding:18px 0}.button-light{width:100%;justify-content:center}}
 .map-frame{margin-top:35px;border:1px solid #004C8A;height:180px;overflow:hidden}.map-frame iframe{width:100%;height:100%;border:0;filter:grayscale(1) contrast(.9) brightness(.75)}.contact-details a:hover{color:var(--yellow)}
:root{--ink:#004C8A;--muted:#004C8A;--paper:#fff;--line:#004C8A;--orange:#008FFA;--yellow:#008FFA;--white:#fff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:15px;overflow-x:hidden}a{color:inherit;text-decoration:none}.reveal,.reveal-up,.reveal-contact{opacity:0;transform:translateY(36px) scale(.98);filter:blur(8px);transition:opacity .7s ease,transform .7s cubic-bezier(.22,1,.36,1),filter .7s ease;will-change:transform,opacity,filter}.reveal.is-visible,.reveal-up.is-visible,.reveal-contact.is-visible{opacity:1;transform:none;filter:none}.site-footer{background:#004C8A;color:#ecf3ff;padding:72px 5vw 34px;border-top:1px solid rgba(255,255,255,.08)}.site-footer .footer-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:48px;align-items:start}.site-footer .brand{display:inline-flex;margin-bottom:18px}.site-footer .brand img{height:52px;width:auto}.footer-copy{max-width:320px;color:rgba(236,243,255,.75);line-height:1.7;margin:0}.footer-col h4{margin:0 0 18px;color:#fff;font-size:11px;letter-spacing:1.7px;text-transform:uppercase;font-weight:700}.footer-links,.footer-contact{display:grid;gap:10px}.footer-links a,.footer-contact a,.footer-contact p{color:rgba(236,243,255,.8);font-size:14px;line-height:1.8}.footer-links a:hover,.footer-contact a:hover{color:#008FFA}.footer-bottom{max-width:1200px;margin:30px auto 0;padding-top:20px;border-top:1px solid rgba(255,255,255,.08);display:flex;align-items:center;justify-content:space-between;gap:20px;color:rgba(236,243,255,.67);font-size:13px}.footer-social{display:flex;align-items:center;gap:10px}.footer-social a{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);transition:transform .25s ease,background .25s ease}.footer-social a:hover{transform:translateY(-2px);background:rgba(0,139,250,.12)}.site-header{height:84px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;padding:0 5vw;border-bottom:1px solid rgba(0,76,138,0);background:rgba(255,255,255,.92);position:sticky;top:0;z-index:5;gap:20px;transition:all .45s cubic-bezier(.22,.58,.56,1);box-shadow:0 0px 0 rgba(0,76,138,0);backdrop-filter:blur(0px)}
.site-header.is-scrolled{background:rgba(255,255,255,.96);border-bottom:1px solid rgba(0,76,138,.15);box-shadow:0 8px 40px rgba(0,76,138,.12);backdrop-filter:blur(10px)}
.brand{display:flex;align-items:center;justify-content:flex-start;line-height:0;flex-shrink:0;transition:transform .4s cubic-bezier(.22,.58,.56,1)}
.brand img{display:block;height:58px;width:auto;max-width:230px;object-fit:contain;transition:filter .4s ease;filter:drop-shadow(0 0px 0 rgba(0,76,138,0))}
.site-header.is-scrolled .brand img{filter:drop-shadow(0 4px 12px rgba(0,76,138,.1))}
.main-nav{display:flex;align-items:center;justify-content:center;gap:32px;text-transform:uppercase;font-size:11px;letter-spacing:1.4px;font-weight:700}
.main-nav a{transition:all .3s ease;opacity:1;color:var(--ink)}
.site-header.is-scrolled .main-nav a{opacity:.85}
.main-nav a:hover{opacity:1;color:var(--orange);transform:translateY(-1px)}
.header-right{display:flex;align-items:center;justify-content:flex-end;gap:14px}
.language-switcher{display:flex;align-items:center;gap:8px;padding:6px 8px;border:1px solid rgba(0,76,138,.18);border-radius:999px;background:#fff;transition:all .3s ease}
.site-header.is-scrolled .language-switcher{background:rgba(255,255,255,.95);border-color:rgba(0,76,138,.22)}
.lang-btn{display:grid;place-items:center;min-width:38px;height:30px;border:0;border-radius:999px;background:transparent;color:var(--ink);font-size:12px;font-weight:700;letter-spacing:.08em;cursor:pointer;transition:all .25s cubic-bezier(.34,1.56,.64,1);padding:0;overflow:hidden}
.lang-btn img{display:block;width:22px;height:22px;object-fit:cover;border-radius:50%;transition:transform .25s ease}
.lang-btn:hover img{transform:scale(1.1)}
.lang-btn.active{background:#fff;box-shadow:0 8px 20px rgba(0,76,138,.15);transform:translateY(-2px)}
.lang-btn.active img{transform:scale(1.15)}
.header-cta{display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;border-radius:999px;background:var(--ink);color:#fff;font-size:12px;font-weight:700;box-shadow:0 8px 20px rgba(0,76,138,.15);transition:all .3s cubic-bezier(.34,1.56,.64,1)}
.header-cta:hover{background:var(--orange);transform:translateY(-2px);box-shadow:0 12px 28px rgba(0,139,250,.25)}
.site-header.is-scrolled .header-cta{box-shadow:0 10px 28px rgba(0,76,138,.18)}
.header-cta span,.text-link span{color:#fff;font-size:18px;margin-left:7px}
@media(max-width:850px){.site-header{grid-template-columns:auto 1fr auto;gap:12px;padding:0 4vw}.brand img{height:48px;max-width:190px}.main-nav{gap:16px;flex-wrap:wrap}.language-switcher{padding:4px 6px}.lang-btn{min-width:34px;height:28px}}
.hero-slider{position:relative;height:80vh;min-height:80vh;display:flex;align-items:flex-end;overflow:hidden;background:var(--ink)}.hero-slider:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.18),rgba(0,0,0,.18) 26%,rgba(2,9,26,.62) 100%);z-index:1}.slides{position:absolute;inset:0;overflow:hidden}.slide{position:absolute;inset:-8% -4%;opacity:0;visibility:hidden;transform:scale(1.12);background:var(--slide-image) center/cover no-repeat;transition:opacity .9s ease, transform 1.8s ease}.slide.active{opacity:1;visibility:visible;transform:scale(1.03);animation:kenBurns 10s ease-out alternate infinite}.hero-overlay{position:absolute;inset:0;background:radial-gradient(circle at top left,rgba(45,108,255,.28),transparent 24%),linear-gradient(90deg,rgba(2,12,29,.8) 0%,rgba(2,12,29,.52) 38%,rgba(2,12,29,.7) 100%);z-index:2}.hero-content{max-width:680px;color:var(--white);position:relative;z-index:1}.hero-slider.is-loaded .hero-content,.hero-slider.is-loaded .eyebrow,.hero-slider.is-loaded h1,.hero-slider.is-loaded .hero-copy,.hero-slider.is-loaded .hero-actions{opacity:1;transform:none}.hero-slider.is-loaded .eyebrow{transition-delay:.15s}.hero-slider.is-loaded h1{transition-delay:.28s}.hero-slider.is-loaded .hero-copy{transition-delay:.42s}.hero-slider.is-loaded .hero-actions{transition-delay:.56s}.hero-slider .eyebrow,.hero-slider h1,.hero-slider .hero-copy,.hero-slider .hero-actions{opacity:0;transform:translateY(26px);transition:all .8s cubic-bezier(.2,.8,.2,1)}.hero-slider .eyebrow,.hero-slider h1 em{color:#fff}.hero-slider .eyebrow span{background:#fff}.hero-slider h1{font-size:clamp(56px,7vw,116px);letter-spacing:-.06em;line-height:.9;font-family:'Barlow Condensed',sans-serif;text-transform:uppercase;margin:26px 0 18px;color:#fff}.hero-slider h1 em{color:#7cc6ff}.hero-copy{max-width:600px;color:rgba(255,255,255,.82);line-height:1.7;font-size:17px;margin:0}.hero-actions{display:flex;gap:31px;align-items:center;margin-top:34px}.button{display:inline-flex;align-items:center;justify-content:center;gap:24px;border:0;padding:15px 21px;font-family:inherit;font-size:12px;letter-spacing:.8px;text-transform:uppercase;font-weight:700;border-radius:0;cursor:pointer;transition:transform .25s ease,box-shadow .25s ease,background .25s ease,color .25s ease}.button:hover{transform:translateY(-2px)}.button-primary{background:var(--orange);color:var(--paper);box-shadow:0 0 0 rgba(124,198,255,0),0 18px 35px rgba(36,84,164,.25)}.button-primary:hover{background:var(--yellow);color:var(--ink);box-shadow:0 0 24px rgba(124,198,255,.55),0 18px 38px rgba(36,84,164,.38)}.button-primary span,.text-link span{color:#fff}.hero-dots{position:absolute;left:42px;top:50%;transform:translateY(-50%);z-index:4;display:flex;flex-direction:column;gap:16px}.dot{width:18px;height:18px;border-radius:50%;border:1px solid rgba(255,255,255,.8);background:rgba(255,255,255,.12);cursor:pointer;transition:all .35s ease,padding .35s ease;position:relative;padding:0;box-shadow:0 0 0 rgba(255,255,255,0)}.dot:before{content:"";position:absolute;inset:4px;border-radius:50%;background:transparent;transition:all .35s ease}.dot.active{background:rgba(255,255,255,.96);border-color:#fff;box-shadow:0 0 18px rgba(255,255,255,.42);transform:scale(1.25)}.dot.active:before{background:#6fb4ff;inset:5px}.hero-controls{position:absolute;left:42px;bottom:34px;z-index:4;display:flex;gap:12px}.nav-arrow{width:42px;height:42px;border:1px solid rgba(255,255,255,.82);background:rgba(5,16,30,.15);color:#fff;cursor:pointer;font-size:22px;display:grid;place-items:center;transition:all .25s ease;box-shadow:0 0 0 rgba(255,255,255,0)}.nav-arrow:hover{background:rgba(255,255,255,.1);border-color:#fff;box-shadow:0 0 24px rgba(124,198,255,.38);transform:translateY(-1px)}.hero{min-height:650px;padding:px 12vw 70px;position:relative;display:flex;align-items:flex-start;overflow:hidden;background:var(--ink)}@media(max-width:850px){.brand img{height:48px;max-width:190px}.hero-slider{min-height:calc(100vh - 70px)}.hero-content{width:min(82vw,760px);margin:0 auto 80px}.hero-dots{left:20px}.hero-controls{left:20px;bottom:20px}.nav-arrow{width:38px;height:38px}.hero-copy{font-size:15px}}@media(max-width:500px){.hero-slider{height:68vh;min-height:68vh}.hero-content{margin-bottom:72px;padding:0 7vw}.hero-dots{top:auto;bottom:68px;left:18px;flex-direction:row}.hero-controls{left:18px;bottom:18px}.hero-copy{max-width:420px}}@keyframes kenBurns{0%{transform:scale(1.12)}100%{transform:scale(1.02)}}@media(prefers-reduced-motion:reduce){.slide,.dot,.nav-arrow,.button,.hero-content,.hero-slider .eyebrow,.hero-slider h1,.hero-slider .hero-copy,.hero-slider .hero-actions{transition:none;animation:none}}@keyframes hero-image-drop{0%{transform:translateY(-100%)}80%{transform:translateY(3%)}100%{transform:translateY(0)}}
@keyframes hero-text-reveal{0%{opacity:0;transform:translateY(-28px)}100%{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){.slide,.dot,.nav-arrow,.button,.hero-content,.hero-slider .eyebrow,.hero-slider h1,.hero-slider .hero-copy,.hero-slider .hero-actions{transition:none;animation:none}}

/* About page */
.about-page{--about-blue:#004C8A
.hero .eyebrow,.hero h1 em,.hero .hero-note strong,.hero .hero-scroll{color:#fff}.hero .note-line,.hero .eyebrow span{border-color:#fff;background:#fff}.hero:before{content:"";position:absolute;inset:50% 0 0;background:linear-gradient(180deg,rgba(22,75,82,.28),rgba(22,75,82,.08)),var(--hero-image) center/cover no-repeat}.hero .hero-content,.hero .hero-note,.hero .hero-scroll{z-index:1}
.hero{min-height:calc(100svh - 84px);height:calc(100svh - 84px);padding:12vh 12vw 70px}
@media(max-width:850px){.hero{min-height:calc(100svh - 70px);height:calc(100svh - 70px)}}
.hero-overlay{
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top left,rgba(45,108,255,.28),transparent 24%),linear-gradient(90deg,rgba(2,12,29,.8) 0%,rgba(2,12,29,.52) 38%,rgba(2,12,29,.7) 100%);
    z-index: 2;
}
.hero h1,.hero h1 em{color:#fff}
.hero-overlay h1 span{margin-right:.18em}
.hero:before{transform:translateY(-100%);animation:hero-image-drop 1.4s cubic-bezier(.22,1.2,.36,1) forwards};--about-orange:#008FFA;background:#fff;color:var(--about-blue)}
.about-page .site-header{background:#fff;border-color:rgba(0,76,138,.22)}
.about-page .main-nav .is-active{color:var(--about-orange)}
.about-page .brand-mark,.about-page .button-primary{background:var(--about-orange)}
.about-page .brand>span:last-child span,.about-page .eyebrow span,.about-page em{color:var(--about-orange)}
.about-hero{min-height:610px;padding:100px 12vw 75px;background:var(--about-blue);color:#fff;display:flex;align-items:center;justify-content:space-between;position:relative;overflow:hidden}
.about-hero:after{content:'04';position:absolute;right:7vw;bottom:-105px;color:rgba(255,255,255,.07);font:700 360px/.8 'Barlow Condensed';letter-spacing:-12px}
.about-hero-copy{position:relative;z-index:1;max-width:730px}
.about-hero .eyebrow{color:#fff}.about-hero .eyebrow span{background:#fff}.about-hero h1{font-size:clamp(76px,10vw,150px);margin:35px 0 30px}.about-hero h1 em{color:#008FFA}.about-hero-intro{max-width:470px;font-size:18px;line-height:1.6;color:rgba(255,255,255,.78)}
.about-hero-stamp{width:190px;height:190px;border:1px solid rgba(255,255,255,.52);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;transform:rotate(9deg);position:relative;z-index:1;animation:stamp-in 1s .7s both cubic-bezier(.22,1,.36,1)}
.about-hero-stamp span{font:700 48px/.8 'Barlow Condensed';color:#008FFA}.about-hero-stamp strong{font:700 16px 'Barlow Condensed';letter-spacing:2px}.about-hero-stamp small{margin-top:12px;font-size:9px;letter-spacing:1px;text-transform:uppercase;color:rgba(255,255,255,.7)}
.about-story{padding-top:110px;padding-bottom:115px}.story-grid{display:grid;grid-template-columns:1fr 1fr;gap:10vw;margin:65px 0 80px}.story-title{display:flex;gap:28px}.story-line{width:4px;height:130px;background:var(--about-orange);flex:none}.story-title h2,.about-process h2{font:700 clamp(54px,6vw,88px)/.86 'Barlow Condensed';text-transform:uppercase}.story-copy{max-width:520px}.story-copy p{color:#004C8A;line-height:1.75;margin:0 0 20px}.story-copy .lead{font-size:21px;line-height:1.45;color:var(--about-blue)}
.about-stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(0,76,138,.25);border-bottom:1px solid rgba(0,76,138,.25)}.about-stats div{padding:28px 22px;border-right:1px solid rgba(0,76,138,.25)}.about-stats div:last-child{border-right:0}.about-stats strong{display:block;font:700 68px/.85 'Barlow Condensed'}.about-stats strong span{color:var(--about-orange)}.about-stats small{display:block;margin-top:12px;font-size:10px;letter-spacing:1.4px;text-transform:uppercase}
.about-commitment{background:#008FFA;color:#fff;padding:100px 0}.commitment-inner .section-kicker{color:var(--about-blue)}.commitment-grid{display:grid;grid-template-columns:1fr 1fr;gap:10vw;align-items:end;margin-top:60px}.commitment-grid h2{font:700 clamp(58px,7vw,100px)/.84 'Barlow Condensed';text-transform:uppercase}.commitment-grid h2 em{color:var(--about-orange)}.commitment-grid p{max-width:420px;line-height:1.75;margin:0 0 32px}.commitment-grid .button-primary{color:#fff}
.about-process{padding-top:110px;padding-bottom:120px}.process-head{display:flex;justify-content:space-between;gap:40px;align-items:end;margin:55px 0 65px}.process-head p{max-width:290px;color:#004C8A;line-height:1.7;margin:0}.process-list{border-top:1px solid rgba(0,76,138,.3)}.process-item{display:grid;grid-template-columns:80px 1fr 1fr;align-items:center;padding:23px 0;border-bottom:1px solid rgba(0,76,138,.3);transition:padding .3s,background .3s}.process-item:hover{padding-left:18px;padding-right:18px;background:#fff}.process-item b{font-size:11px;color:var(--about-orange)}.process-item strong{font:700 32px 'Barlow Condensed';text-transform:uppercase}.process-item span{font-size:12px;color:#004C8A;text-transform:uppercase;letter-spacing:1px}
.about-closing{background:var(--about-blue);color:#fff;padding:105px 0}.closing-inner .eyebrow{color:#fff}.closing-inner .eyebrow span{background:#fff}.closing-inner h2{font:700 clamp(60px,8vw,110px)/.84 'Barlow Condensed';text-transform:uppercase;margin:42px 0}.closing-inner h2 em{color:#008FFA}.button-light{display:inline-flex}.about-page footer{background:#fff}
.reveal-up{animation:about-reveal .8s both cubic-bezier(.22,1,.36,1)}.story-copy{animation-delay:.12s}.process-item:nth-child(2){animation-delay:.1s}.process-item:nth-child(3){animation-delay:.2s}.process-item:nth-child(4){animation-delay:.3s}
@keyframes about-reveal{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}@keyframes stamp-in{from{opacity:0;transform:rotate(-8deg) scale(.7)}to{opacity:1;transform:rotate(9deg) scale(1)}}
@media(max-width:850px){.about-hero{min-height:600px;padding:80px 8vw;align-items:flex-start}.about-hero-stamp{position:absolute;right:8vw;bottom:40px;width:125px;height:125px}.about-hero-stamp span{font-size:34px}.about-hero-stamp strong{font-size:12px}.about-hero-stamp small{font-size:7px}.story-grid,.commitment-grid{grid-template-columns:1fr;gap:45px}.about-story,.about-process{padding-top:75px;padding-bottom:80px}.about-stats{margin-top:20px}.process-head{display:block;margin:45px 0}.process-head p{margin-top:25px}.about-commitment{padding:75px 0}}
@media(max-width:500px){.about-hero{min-height:560px;padding:70px 7vw}.about-hero h1{font-size:clamp(68px,19vw,96px)}.about-hero-intro{font-size:16px}.story-title h2,.about-process h2{font-size:58px}.about-stats{grid-template-columns:1fr}.about-stats div{border-right:0;border-bottom:1px solid rgba(0,76,138,.25)}.about-stats div:last-child{border-bottom:0}.process-item{grid-template-columns:45px 1fr}.process-item span{grid-column:2;margin-top:4px}.process-item strong{font-size:28px}.closing-inner h2{font-size:68px}}
@media(prefers-reduced-motion:reduce){.about-page .reveal-up,.about-hero-stamp{animation:none}}

/* Contact page */
.contact-page{--contact-blue:#004C8A;--contact-orange:#008FFA;background:#fff;color:var(--contact-blue)}
.contact-page .site-header{background:#fff;border-color:rgba(0,76,138,.22)}.contact-page .main-nav .is-active{color:var(--contact-orange)}.contact-page .brand-mark,.contact-page .button-primary{background:var(--contact-orange)}.contact-page .brand>span:last-child span,.contact-page .eyebrow span,.contact-page em{color:var(--contact-orange)}
.contact-hero{min-height:430px;padding:75px 12vw;background:var(--contact-blue);color:#fff;display:flex;align-items:center;justify-content:space-between;position:relative;overflow:hidden}.contact-hero:after{content:'05';position:absolute;right:8vw;bottom:-80px;color:rgba(255,255,255,.07);font:700 320px/.8 'Barlow Condensed';letter-spacing:-10px}.contact-hero-copy{position:relative;z-index:1}.contact-hero .eyebrow{color:#fff}.contact-hero .eyebrow span{background:#fff}.contact-hero h1{font-size:clamp(76px,9vw,136px);margin:28px 0 24px}.contact-hero h1 em{color:#008FFA}.contact-hero-copy>p:last-child{max-width:460px;color:rgba(255,255,255,.75);font-size:17px;line-height:1.65}.contact-hero-index{position:relative;z-index:1;align-self:flex-start;margin-top:20px;font:700 24px 'Barlow Condensed';color:#008FFA;text-transform:uppercase}.contact-hero-index span{display:block;margin-top:7px;color:#fff;font:700 11px 'DM Sans';letter-spacing:2px}
.contact-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:9vw;padding-top:105px;padding-bottom:115px}.contact-sidebar .section-kicker{color:var(--contact-orange)}.contact-sidebar h2{font:700 clamp(56px,6vw,86px)/.86 'Barlow Condensed';text-transform:uppercase;margin:48px 0 25px}.contact-sidebar h2 em{color:var(--contact-orange)}.contact-sidebar>p{max-width:350px;color:#004C8A;line-height:1.7}.contact-info-list{margin-top:53px;border-top:1px solid rgba(0,76,138,.25)}.contact-info-list>div{padding:18px 0;border-bottom:1px solid rgba(0,76,138,.25)}.contact-info-list small{display:block;margin-bottom:7px;color:var(--contact-orange);font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase}.contact-info-list a,.contact-info-list strong{font-size:13px;line-height:1.65}.contact-info-list a span{float:right;color:var(--contact-orange);font-size:18px}.contact-info-list a:hover{color:var(--contact-orange)}
.contact-panel{background:#fff;padding:30px 34px 25px;border-top:5px solid var(--contact-orange);box-shadow:16px 16px 0 #008FFA}.contact-panel-top{display:flex;justify-content:space-between;padding-bottom:22px;border-bottom:1px solid rgba(0,76,138,.18);font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase}.contact-panel-top span:last-child{color:var(--contact-orange)}.contact-form-large{display:grid;grid-template-columns:1fr 1fr;gap:21px 18px;padding-top:27px}.contact-form-large label{display:flex;flex-direction:column;gap:9px;color:var(--contact-blue);font-size:10px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase}.contact-form-large label:nth-of-type(4),.contact-form-large button{grid-column:1/-1}.contact-form-large input,.contact-form-large textarea{width:100%;border:0;border-bottom:1px solid rgba(0,76,138,.35);border-radius:0;background:transparent;padding:9px 0;color:var(--contact-blue);font:14px 'DM Sans';outline:0;resize:vertical;transition:border-color .25s,background .25s}.contact-form-large input:focus,.contact-form-large textarea:focus{border-color:var(--contact-orange);background:rgba(0,139,250,.12)}.contact-form-large input::placeholder,.contact-form-large textarea::placeholder{color:#004C8A}.contact-form-large button{justify-self:start;margin-top:5px}.form-note{margin:20px 0 0;color:#004C8A;font-size:10px;line-height:1.5}
.contact-next{background:#008FFA;padding:90px 0 105px}.contact-next .section-kicker{color:#fff}.contact-next h2{font:700 clamp(60px,7vw,98px)/.84 'Barlow Condensed';text-transform:uppercase;margin:45px 0 60px}.contact-next h2 em{color:var(--contact-orange)}.promise-row{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(0,76,138,.35)}.promise-row>div{padding:24px 25px 0 0;border-right:1px solid rgba(0,76,138,.35)}.promise-row>div:not(:first-child){padding-left:25px}.promise-row>div:last-child{border-right:0}.promise-row b{display:block;color:var(--contact-orange);font-size:11px}.promise-row strong{display:block;margin:15px 0 8px;font:700 30px 'Barlow Condensed';text-transform:uppercase}.promise-row p{max-width:220px;margin:0;color:#004C8A;font-size:13px;line-height:1.6}
.contact-page .reveal-contact{animation:contact-reveal .8s both cubic-bezier(.22,1,.36,1)}.contact-panel{animation-delay:.12s}@keyframes contact-reveal{from{opacity:0;transform:translateY(32px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:850px){.contact-hero{padding:75px 8vw;min-height:500px}.contact-hero-index{position:absolute;right:8vw;bottom:38px}.contact-layout{grid-template-columns:1fr;gap:65px;padding-top:75px;padding-bottom:90px}.contact-next{padding:75px 0 85px}.promise-row{grid-template-columns:1fr}.promise-row>div,.promise-row>div:not(:first-child){padding:20px 0;border-right:0;border-bottom:1px solid rgba(0,76,138,.35)}.promise-row>div:last-child{border-bottom:0}}
@media(max-width:500px){.contact-hero{padding:62px 7vw}.contact-hero h1{font-size:clamp(70px,19vw,95px)}.contact-hero-copy>p:last-child{font-size:15px}.contact-panel{padding:24px 20px 20px;box-shadow:9px 9px 0 #008FFA}.contact-form-large{grid-template-columns:1fr}.contact-form-large label:nth-of-type(4),.contact-form-large button{grid-column:auto}.contact-next h2{font-size:68px}}
@media(prefers-reduced-motion:reduce){.contact-page .reveal-contact{animation:none}}
